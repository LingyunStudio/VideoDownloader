<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="VideoDownloader.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:VideoDownloader.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OmniboxBackgroundBrush" Color="#F5FFFFFF" />
                    <SolidColorBrush x:Key="OmniboxBorderBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="CardElevatedBrush" Color="#EAFFFFFF" />
                    <SolidColorBrush x:Key="CardSubtleBrush" Color="#75F6F8FB" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="PresetSelectedBgBrush" Color="#140078D4" />
                    <SolidColorBrush x:Key="SuccessSoftBgBrush" Color="#1A107C10" />
                    <SolidColorBrush x:Key="SuccessTextBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="WarningSoftBgBrush" Color="#1FD87B00" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="DangerSoftBgBrush" Color="#1AC42B1C" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="InfoSoftBgBrush" Color="#160067C0" />
                    <SolidColorBrush x:Key="InfoTextBrush" Color="#005FB8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OmniboxBackgroundBrush" Color="#C828282C" />
                    <SolidColorBrush x:Key="OmniboxBorderBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#8826262A" />
                    <SolidColorBrush x:Key="CardElevatedBrush" Color="#B82C2C30" />
                    <SolidColorBrush x:Key="CardSubtleBrush" Color="#44FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#772E2E33" />
                    <SolidColorBrush x:Key="PresetSelectedBgBrush" Color="#2860CDFF" />
                    <SolidColorBrush x:Key="SuccessSoftBgBrush" Color="#266CCB5F" />
                    <SolidColorBrush x:Key="SuccessTextBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="WarningSoftBgBrush" Color="#26FCE100" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="DangerSoftBgBrush" Color="#26FF99A4" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="InfoSoftBgBrush" Color="#2460CDFF" />
                    <SolidColorBrush x:Key="InfoTextBrush" Color="#60CDFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Value Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:CountToVisibilityConverter x:Key="EmptyToVis" Invert="True" />

            <!-- Fluent 2 Surface Cards -->
            <Style x:Key="FluentCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20,18" />
            </Style>

            <Style x:Key="FluentSubCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <!-- Windows 11 SettingsRow Card -->
            <Style x:Key="SettingsItemCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,14" />
            </Style>

            <!-- Compact Quick Chip Container -->
            <Style x:Key="QuickChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ChipBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,5" />
            </Style>

            <!-- Badges / Pills -->
            <Style x:Key="PillBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,2" />
            </Style>

            <Style x:Key="AccentPillBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InfoSoftBgBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,2" />
            </Style>

            <Style x:Key="SuccessPillBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SuccessSoftBgBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,2" />
            </Style>

            <Style x:Key="WarningPillBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WarningSoftBgBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,2" />
            </Style>

            <!-- Typography -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-10" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="CaptionMutedStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Frameless Omnibox TextBox -->
            <Style x:Key="OmniboxTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="4,8" />
            </Style>

            <!-- Icon-only Subtle Action Button -->
            <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
