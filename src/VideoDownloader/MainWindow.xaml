<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VideoDownloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VideoDownloader">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent 2 Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="20" Height="20" Stretch="Uniform" />
                <TextBlock Text="VideoDownloader"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Style="{StaticResource AccentPillBadgeStyle}" VerticalAlignment="Center">
                    <TextBlock Text="v3.0.2"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource InfoTextBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- First-Run Engine Setup Banner (yt-dlp / ffmpeg) -->
        <Border Grid.Row="1"
                Margin="16,0,16,8"
                Padding="16,10"
                CornerRadius="10"
                Background="{ThemeResource InfoSoftBgBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Visibility="{x:Bind ViewModel.ToolSetupBannerVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="15" Foreground="{ThemeResource InfoTextBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.ToolSetupMessage, Mode=OneWay}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="2"
                             VerticalAlignment="Center"
                             Minimum="0" Maximum="100"
                             Value="{x:Bind ViewModel.ToolSetupProgress, Mode=OneWay}"
                             IsIndeterminate="{x:Bind ViewModel.IsToolSetupIndeterminate, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Main Navigation Shell -->
        <NavigationView x:Name="NavView"
                        Grid.Row="2"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="196"
                        CompactModeThresholdWidth="680"
                        ExpandedModeThresholdWidth="1040"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="解析下载" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDownloads" Content="下载队列" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.ActiveDownloadCount, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.ActiveBadgeVisibility, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHistory" Content="下载历史" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings" Content="设置与更新" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
