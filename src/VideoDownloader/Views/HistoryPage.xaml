<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VideoDownloader.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VideoDownloader.Models"
    Background="Transparent">

    <Grid Padding="32,18,32,28" RowSpacing="18" MaxWidth="1080">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + Search + Clear -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="下载历史" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="已完成的任务自动归档，随时定位本地文件或重新解析" Style="{StaticResource CaptionMutedStyle}" />
            </StackPanel>

            <TextBox Grid.Column="1"
                     PlaceholderText="搜索标题、站点或链接…"
                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" />

            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.ClearAllCommand}"
                    CornerRadius="8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    <TextBlock Text="清空历史" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Refined Empty State -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
            <Border Width="68" Height="68" CornerRadius="18" Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE81C;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Border>
            <TextBlock Text="暂无下载记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="完成下载的视频会自动记录在这里，支持搜索与一键重下"
                       Style="{StaticResource CaptionMutedStyle}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- History List -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.FilteredEntries}"
                  SelectionMode="None"
                  Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryEntry">
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{ThemeResource SuccessSoftBgBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SuccessTextBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Style="{StaticResource AccentPillBadgeStyle}">
                                        <TextBlock Text="{x:Bind DisplaySource}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource InfoTextBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource PillBadgeStyle}">
                                        <TextBlock Text="{x:Bind FormatSummary}" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{x:Bind FileSizeText}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="·" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind CompletedAtText}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="定位文件" CornerRadius="6" Tag="{x:Bind}" Click="OpenFile_Click" Margin="0,0,4,0" />
                                <Button Style="{StaticResource SubtleIconButtonStyle}" ToolTipService.ToolTip="重新解析并下载" Tag="{x:Bind}" Click="Redownload_Click">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource SubtleIconButtonStyle}" ToolTipService.ToolTip="在浏览器中打开原网页" Tag="{x:Bind}" Click="OpenWeb_Click">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource SubtleIconButtonStyle}" ToolTipService.ToolTip="删除此记录" Tag="{x:Bind}" Click="Delete_Click">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
