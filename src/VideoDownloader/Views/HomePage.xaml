<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VideoDownloader.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VideoDownloader.Models"
    xmlns:services="using:VideoDownloader.Services"
    Background="Transparent">

    <Page.Resources>
        <!-- Reusable Format Row Template -->
        <DataTemplate x:Key="FormatItemTemplate" x:DataType="models:FormatOption">
            <Grid Margin="0,3">
                <Border Padding="14,10"
                        CornerRadius="8"
                        Background="{ThemeResource CardSurfaceBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="68" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                  IsHitTestVisible="False"
                                  MinWidth="0"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind ResolutionText}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind FormatId}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind CodecDisplay}" FontSize="12" FontWeight="Medium" />
                        </Border>

                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind SummaryLine}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="4"
                                   Text="{x:Bind SizeText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="5"
                                Style="{StaticResource WarningPillBadgeStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind RecommendedMark, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="推荐" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WarningTextBrush}" />
                        </Border>
                    </Grid>
                </Border>
                <!-- Left Accent Selection Indicator -->
                <Border Width="3"
                        Margin="1,8,0,8"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- Playlist Entry Row Template -->
        <DataTemplate x:Key="PlaylistEntryTemplate" x:DataType="models:PlaylistEntryItem">
            <Border Margin="0,2"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{ThemeResource CardSurfaceBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource AccentPillBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind IndexText}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource InfoTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Uploader}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind Uploader, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CookieSourceTemplate" x:DataType="services:CookieSourceChoice">
            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!-- Clean Preset Card Button Wrapper -->
        <Style x:Key="PresetCardButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageRootGrid" Padding="28,16,28,36" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Full-Width Area: Hero Header + Omnibox + Quick Chips + Status/InfoBars -->
            <StackPanel Grid.Row="0" Spacing="14">

                <!-- Clean Hero Header -->
                <StackPanel Spacing="3">
                    <TextBlock Text="解析与下载" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="粘贴任意视频、播放列表或直播链接，支持内置登录与全场景画质定制"
                               Style="{StaticResource CaptionMutedStyle}" />
                </StackPanel>

                <!-- Modern Elevated Omnibox Search Bar -->
                <StackPanel Spacing="10">
                    <Border Background="{ThemeResource OmniboxBackgroundBrush}"
                            BorderBrush="{ThemeResource OmniboxBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,8,8,8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE71B;"
                                      FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="2,0,4,0" />

                            <TextBox x:Name="UrlTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource OmniboxTextBoxStyle}"
                                     Text="{x:Bind ViewModel.UrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="在此粘贴链接（支持多行批量链接 · 回车立即解析）"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="84"
                                     VerticalAlignment="Center"
                                     KeyDown="UrlTextBox_KeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>

                            <Button Grid.Column="2"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    Command="{x:Bind ViewModel.ClearUrlCommand}"
                                    ToolTipService.ToolTip="清空"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.HasUrlInput, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>

                            <Button Grid.Column="3"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    Click="PasteClipboard_Click"
                                    ToolTipService.ToolTip="从剪贴板粘贴"
                                    Padding="10,7"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE77F;" FontSize="13" />
                                    <TextBlock Text="粘贴" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ParseCommand}"
                                    Height="38"
                                    Padding="20,0"
                                    CornerRadius="10"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                                    <TextBlock Text="解析" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Sleek Quick-Control Chips Bar -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Chip 1: Playlist Mode Flyout -->
                        <DropDownButton Grid.Column="0"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Background="{ThemeResource ChipBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        ToolTipService.ToolTip="选择如何处理包含播放列表参数的链接">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PlaylistModeShortLabel, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Text="自动智能（推荐）" Command="{x:Bind ViewModel.SetPlaylistModeCommand}" CommandParameter="0">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="仅当前视频 (--no-playlist)" Command="{x:Bind ViewModel.SetPlaylistModeCommand}" CommandParameter="1">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="整个播放列表 (--yes-playlist)" Command="{x:Bind ViewModel.SetPlaylistModeCommand}" CommandParameter="2">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- Chip 2: Cookies & Built-in Login Flyout -->
                        <DropDownButton Grid.Column="1"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Background="{ThemeResource ChipBackgroundBrush}"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CookieStatusHint, Mode=OneWay}">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{ThemeResource SuccessTextBrush}"
                                             VerticalAlignment="Center"
                                             Visibility="{x:Bind ViewModel.IsCookieAuthenticated, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                             VerticalAlignment="Center"
                                             Visibility="{x:Bind ViewModel.IsCookieAuthenticated, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBlock Text="{x:Bind ViewModel.CookieChipLabel, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Width="320" Spacing="12" Padding="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="网站登录态与 Cookies 管理" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{x:Bind ViewModel.CookieStatusHint, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="OpenCookieLogin_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                                <TextBlock Text="打开内置网页登录（推荐）" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <ComboBox Header="切换 Cookies 来源"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind ViewModel.CookieSources}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedCookieSource, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource CookieSourceTemplate}" />

                                        <Button HorizontalAlignment="Stretch" Click="BrowseCookieFile_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                                <TextBlock Text="导入本地 Netscape cookies.txt…" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- Chip 3: Save Directory Pill -->
                        <Border Grid.Column="2"
                                HorizontalAlignment="Left"
                                Style="{StaticResource QuickChipStyle}"
                                Padding="10,3,4,3">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SaveDirTextBlock"
                                           Text="{x:Bind ViewModel.ShortOutputDirectory, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.OutputDirectory, Mode=OneWay}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           MaxWidth="320"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Content="更改"
                                        Style="{StaticResource SubtleIconButtonStyle}"
                                        Padding="8,3"
                                        FontSize="12"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Click="BrowseOutputDir_Click" />
                                <Button Style="{StaticResource SubtleIconButtonStyle}"
                                        Padding="6,4"
                                        Command="{x:Bind ViewModel.OpenOutputDirectoryCommand}"
                                        ToolTipService.ToolTip="在资源管理器中打开保存目录">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Mixed Video+Playlist Smart Hint -->
                    <Border Style="{StaticResource FluentSubCardStyle}"
                            Visibility="{x:Bind ViewModel.ShowMixedListHint, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource InfoTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="检测到混合链接（同时含单视频与播放列表参数）。默认优先解析当前视频，也可以直接切换："
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="仅此视频" Command="{x:Bind ViewModel.ParseSingleVideoCommand}" Padding="10,4" FontSize="12" />
                                <Button Content="整个列表" Command="{x:Bind ViewModel.ParseFullPlaylistCommand}" Padding="10,4" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Parsing Inline Progress -->
                    <Border Style="{StaticResource FluentSubCardStyle}"
                            Visibility="{x:Bind ViewModel.IsParsing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing Grid.Column="0" IsActive="True" Width="18" Height="18" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                            <Button Grid.Column="2" Content="取消" Command="{x:Bind ViewModel.CancelParseCommand}" Padding="12,4" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Actionable Feedback InfoBars -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsErrorBannerOpen, Mode=TwoWay}"
                         Severity="Error"
                         Title="解析或操作失败"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="网页登录获取 Cookies"
                                Click="OpenCookieLogin_Click"
                                Visibility="{x:Bind ViewModel.IsAuthRelatedError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar IsOpen="{x:Bind ViewModel.IsInfoBannerOpen, Mode=TwoWay}"
                         Severity="Success"
                         Title="提示"
                         Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}" />
            </StackPanel>

            <!-- Adaptive Workspace: Single Column on Compact, Dual Column Workbench on Wide/Fullscreen -->
            <Grid x:Name="WorkspaceGrid" Grid.Row="1" RowSpacing="16" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                    <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Primary Left Column: Parsed Video Hero + Presets + Download Action + Streams/Playlist -->
                <StackPanel x:Name="PrimaryColumnPanel" Grid.Row="0" Grid.Column="0" Spacing="16">

                    <!-- Cinematic Parsed Video Hero Card -->
                    <Border Style="{StaticResource FluentCardStyle}"
                            Padding="0"
                            Visibility="{x:Bind ViewModel.HasVideoInfo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid Padding="20,18" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="ThumbnailContainer" Grid.Column="0" Width="264" Height="148" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
                                <!-- Subtle bottom scrim for duration legibility -->
                                <Border VerticalAlignment="Bottom" Height="42">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#AA000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="8"
                                        Padding="7,2"
                                        CornerRadius="5"
                                        Background="#D8000000">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentVideo.DurationText, Mode=OneWay, FallbackValue=''}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Spacing="9" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentVideo.Title, Mode=OneWay, FallbackValue=''}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Style="{StaticResource AccentPillBadgeStyle}"
                                            Visibility="{x:Bind ViewModel.CurrentVideo.Extractor, Mode=OneWay, Converter={StaticResource StringToVis}, FallbackValue=Collapsed}">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentVideo.Extractor, Mode=OneWay, FallbackValue=''}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource InfoTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentVideo.Uploader, Mode=OneWay, FallbackValue=''}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource PillBadgeStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentVideo.ViewCountText, Mode=OneWay, FallbackValue='—'}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource PillBadgeStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE8E1;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentVideo.LikeCountText, Mode=OneWay, FallbackValue='—'}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource PillBadgeStyle}"
                                            Visibility="{x:Bind ViewModel.CurrentVideo.UploadDateText, Mode=OneWay, Converter={StaticResource StringToVis}, FallbackValue=Collapsed}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE787;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentVideo.UploadDateText, Mode=OneWay, FallbackValue=''}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{x:Bind ViewModel.CurrentVideo.SubtitleSummaryText, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource CaptionMutedStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind ViewModel.CurrentVideo.SubtitleSummaryText, Mode=OneWay, Converter={StaticResource StringToVis}, FallbackValue=Collapsed}" />

                                <Border Style="{StaticResource FluentSubCardStyle}"
                                        Visibility="{x:Bind ViewModel.IsPlaylistInfo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource InfoTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PlaylistNoticeText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Visual Quality Preset Cards -->
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="画质与下载预设" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                        Visibility="{x:Bind ViewModel.IsAudioPreset, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="输出音频格式" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                                <ComboBox Width="110" SelectedItem="{x:Bind ViewModel.SelectedAudioFormat, Mode=TwoWay}">
                                    <x:String>mp3</x:String>
                                    <x:String>m4a</x:String>
                                    <x:String>flac</x:String>
                                    <x:String>opus</x:String>
                                    <x:String>wav</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Preset 0: Best Quality -->
                            <Button Grid.Column="0" Style="{StaticResource PresetCardButtonStyle}" Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="0">
                                <Grid>
                                    <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE734;" FontSize="18" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="最佳画质" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="原画音视频自动合并" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource PresetSelectedBgBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" IsHitTestVisible="False"
                                            Visibility="{x:Bind ViewModel.IsPreset0, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Preset 1: Compat MP4 -->
                            <Button Grid.Column="1" Style="{StaticResource PresetCardButtonStyle}" Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="1">
                                <Grid>
                                    <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE714;" FontSize="18" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="兼容 MP4" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="H.264 直出零转码" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource PresetSelectedBgBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" IsHitTestVisible="False"
                                            Visibility="{x:Bind ViewModel.IsPreset1, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Preset 2: 1080p Balanced -->
                            <Button Grid.Column="2" Style="{StaticResource PresetCardButtonStyle}" Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="2">
                                <Grid>
                                    <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="18" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="1080p 均衡" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="清晰度与体积平衡" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource PresetSelectedBgBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" IsHitTestVisible="False"
                                            Visibility="{x:Bind ViewModel.IsPreset2, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Preset 3: Audio Only -->
                            <Button Grid.Column="3" Style="{StaticResource PresetCardButtonStyle}" Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="3">
                                <Grid>
                                    <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="18" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="仅提取音频" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="MP3 / M4A / FLAC" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource PresetSelectedBgBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" IsHitTestVisible="False"
                                            Visibility="{x:Bind ViewModel.IsPreset3, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Preset 4: Custom Stream Selection -->
                            <Button Grid.Column="4" Style="{StaticResource PresetCardButtonStyle}" Command="{x:Bind ViewModel.SelectPresetCommand}" CommandParameter="4">
                                <Grid>
                                    <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE9E9;" FontSize="18" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="自定义格式" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="自由勾选音视频流" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource PresetSelectedBgBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" IsHitTestVisible="False"
                                            Visibility="{x:Bind ViewModel.IsPreset4, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" />
                                    </Border>
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- Unified Primary Download Action Bar -->
                        <Border Style="{StaticResource FluentCardStyle}" Padding="18,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="当前执行方案" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectionSummaryText, Mode=OneWay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.PrimaryDownloadCommand}"
                                        Height="40"
                                        Padding="26,0"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="15" />
                                        <TextBlock Text="{x:Bind ViewModel.PrimaryDownloadButtonText, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Playlist Entries Preview -->
                    <Border Style="{StaticResource FluentCardStyle}"
                            Visibility="{x:Bind ViewModel.IsPlaylistInfo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="播放列表条目预览" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         PlaceholderText="下载范围，如 1-5,8,10:20"
                                         Text="{x:Bind ViewModel.PlaylistItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <ListView x:Name="PlaylistEntriesListView"
                                      ItemsSource="{x:Bind ViewModel.PlaylistEntries}"
                                      ItemTemplate="{StaticResource PlaylistEntryTemplate}"
                                      SelectionMode="None"
                                      MaxHeight="300" />
                        </StackPanel>
                    </Border>

                    <!-- Custom Format Picker (Video / Audio / Combined) -->
                    <Border Style="{StaticResource FluentCardStyle}"
                            Visibility="{x:Bind ViewModel.IsSingleVideo, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="精细流选择（点击勾选：1 视频 + 1 音频自动合并，或单选合一流）"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <Pivot SelectedIndex="{x:Bind ViewModel.SelectedFormatTabIndex, Mode=TwoWay}">
                                <PivotItem Header="纯视频流">
                                    <ListView x:Name="VideoFormatsListView"
                                              ItemsSource="{x:Bind ViewModel.VideoFormats}"
                                              ItemTemplate="{StaticResource FormatItemTemplate}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="FormatList_ItemClick"
                                              MaxHeight="340"
                                              Margin="0,6,0,0" />
                                </PivotItem>
                                <PivotItem Header="纯音频流">
                                    <ListView x:Name="AudioFormatsListView"
                                              ItemsSource="{x:Bind ViewModel.AudioFormats}"
                                              ItemTemplate="{StaticResource FormatItemTemplate}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="FormatList_ItemClick"
                                              MaxHeight="340"
                                              Margin="0,6,0,0" />
                                </PivotItem>
                                <PivotItem Header="音视频合一">
                                    <ListView x:Name="CombinedFormatsListView"
                                              ItemsSource="{x:Bind ViewModel.CombinedFormats}"
                                              ItemTemplate="{StaticResource FormatItemTemplate}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="FormatList_ItemClick"
                                              MaxHeight="340"
                                              Margin="0,6,0,0" />
                                </PivotItem>
                            </Pivot>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Secondary Column (Right Pane on Wide, Bottom Drawer on Compact): Advanced yt-dlp Options -->
                <Expander x:Name="AdvancedOptionsExpander"
                          Grid.Row="1"
                          Grid.Column="0"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          CornerRadius="12"
                          Background="{ThemeResource CardSurfaceBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                            <FontIcon Glyph="&#xE9E9;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="高级场景选项与命令预览" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="容器封装 · 字幕与章节 · 片段裁剪 · 直播录制 · 去广告 · 加速与反爬"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>

                    <Pivot Margin="0,4,0,0">
                        <!-- Tab 1 -->
                        <PivotItem Header="容器与列表">
                            <StackPanel Spacing="12" Padding="4,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Header="目标封装容器"
                                              ToolTipService.ToolTip="--merge-output-format"
                                              HorizontalAlignment="Stretch"
                                              SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}">
                                        <x:String>auto</x:String>
                                        <x:String>mp4</x:String>
                                        <x:String>mkv</x:String>
                                        <x:String>webm</x:String>
                                        <x:String>mov</x:String>
                                    </ComboBox>
                                    <TextBox Grid.Column="1"
                                             Header="播放列表范围 (-I)"
                                             PlaceholderText="如 1-10,15 或 -1"
                                             Text="{x:Bind ViewModel.PlaylistItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="无损重封装 (--remux)" ToolTipService.ToolTip="无损重封装为目标容器（--remux-video）" IsChecked="{x:Bind ViewModel.RemuxVideo, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="倒序下载列表" ToolTipService.ToolTip="倒序下载播放列表（--playlist-reverse）" IsChecked="{x:Bind ViewModel.PlaylistReverse, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="去重档案跳过已下" ToolTipService.ToolTip="启用去重档案跳过已下载（--download-archive）" IsChecked="{x:Bind ViewModel.UseArchive, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="使用当前下载时间" ToolTipService.ToolTip="不使用服务器文件时间（--no-mtime）" IsChecked="{x:Bind ViewModel.NoMtime, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </PivotItem>

                        <!-- Tab 2 -->
                        <PivotItem Header="字幕与封面">
                            <StackPanel Spacing="12" Padding="4,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="136" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Header="字幕语言 (--sub-langs)"
                                             PlaceholderText="zh-Hans,zh-CN,zh,en.*"
                                             Text="{x:Bind ViewModel.SubtitleLangs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1"
                                              Header="字幕格式转换"
                                              HorizontalAlignment="Stretch"
                                              SelectedItem="{x:Bind ViewModel.ConvertSubtitles, Mode=TwoWay}">
                                        <x:String>none</x:String>
                                        <x:String>srt</x:String>
                                        <x:String>ass</x:String>
                                        <x:String>vtt</x:String>
                                        <x:String>lrc</x:String>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="下载人工字幕" IsChecked="{x:Bind ViewModel.DownloadSubtitles, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="下载自动字幕" IsChecked="{x:Bind ViewModel.DownloadAutoSubtitles, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="内嵌字幕到视频" IsChecked="{x:Bind ViewModel.EmbedSubtitles, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="写入元数据" IsChecked="{x:Bind ViewModel.EmbedMetadata, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="2" Grid.Column="0" Content="嵌入封面缩略图" IsChecked="{x:Bind ViewModel.EmbedThumbnail, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="单独保存封面图" IsChecked="{x:Bind ViewModel.WriteThumbnail, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="3" Grid.Column="0" Content="嵌入章节标记" IsChecked="{x:Bind ViewModel.EmbedChapters, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="3" Grid.Column="1" Content="按章节切分文件" ToolTipService.ToolTip="按章节自动切分文件（--split-chapters）" IsChecked="{x:Bind ViewModel.SplitChapters, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </PivotItem>

                        <!-- Tab 3 -->
                        <PivotItem Header="剪辑与直播">
                            <StackPanel Spacing="12" Padding="4,10">
                                <TextBox Header="时间片段裁剪 (--download-sections)"
                                         PlaceholderText="例如 00:01:00-00:02:30 或 00:05:00-inf"
                                         Text="{x:Bind ViewModel.SectionRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Header="SponsorBlock 去广告"
                                              HorizontalAlignment="Stretch"
                                              SelectedItem="{x:Bind ViewModel.SponsorBlockMode, Mode=TwoWay}">
                                        <x:String>off</x:String>
                                        <x:String>remove</x:String>
                                        <x:String>mark</x:String>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1"
                                              Header="SponsorBlock 分类"
                                              HorizontalAlignment="Stretch"
                                              SelectedItem="{x:Bind ViewModel.SponsorBlockCategories, Mode=TwoWay}">
                                        <x:String>default</x:String>
                                        <x:String>sponsor</x:String>
                                        <x:String>all</x:String>
                                        <x:String>sponsor,intro,outro</x:String>
                                    </ComboBox>
                                </Grid>

                                <StackPanel Spacing="6">
                                    <CheckBox Content="裁剪时强制重编关键帧 (--force-keyframes-at-cuts)" IsChecked="{x:Bind ViewModel.ForceKeyframesAtCuts, Mode=TwoWay}" />
                                    <CheckBox Content="直播从头开始录制 (--live-from-start)" IsChecked="{x:Bind ViewModel.LiveFromStart, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </PivotItem>

                        <!-- Tab 4 -->
                        <PivotItem Header="加速与命令">
                            <StackPanel Spacing="12" Padding="4,10">
                                <CheckBox Content="启用 aria2c 多线程加速（突破单连接限速）"
                                          ToolTipService.ToolTip="使用 aria2c 多连接分块下载 HTTP/HTTPS 流，突破 YouTube 单连接限速"
                                          IsChecked="{x:Bind ViewModel.UseAria2Acceleration, Mode=TwoWay}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Grid.Column="0"
                                               Header="aria2c 线程数"
                                               Minimum="1" Maximum="16"
                                               SpinButtonPlacementMode="Inline"
                                               Value="{x:Bind ViewModel.Aria2Connections, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1"
                                               Header="HLS 分片线程 (-N)"
                                               Minimum="1" Maximum="16"
                                               SpinButtonPlacementMode="Inline"
                                               Value="{x:Bind ViewModel.ConcurrentFragments, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Header="限速 (-r，如 5M)"
                                             PlaceholderText="留空不限速"
                                             Text="{x:Bind ViewModel.RateLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="1"
                                              Header="浏览器指纹模拟"
                                              HorizontalAlignment="Stretch"
                                              SelectedItem="{x:Bind ViewModel.Impersonate, Mode=TwoWay}">
                                        <x:String>none</x:String>
                                        <x:String>chrome</x:String>
                                        <x:String>edge</x:String>
                                        <x:String>safari</x:String>
                                    </ComboBox>
                                </Grid>

                                <TextBox Header="自定义额外 yt-dlp 参数（支持引号）"
                                         PlaceholderText="例如 --extractor-args &quot;youtube:player_client=tv,web&quot;"
                                         Text="{x:Bind ViewModel.ExtraArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Header="加密视频密码（可选）"
                                             PlaceholderText="--video-password"
                                             Text="{x:Bind ViewModel.VideoPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Column="1"
                                              Content="强制 IPv4"
                                              ToolTipService.ToolTip="强制使用 IPv4 连接 (-4)"
                                              VerticalAlignment="Bottom"
                                              Margin="0,0,0,2"
                                              IsChecked="{x:Bind ViewModel.ForceIpv4, Mode=TwoWay}" />
                                </Grid>

                                <Border Style="{StaticResource FluentSubCardStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Text="等效 yt-dlp 命令行预览" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       IsTextSelectionEnabled="True"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="复制" VerticalAlignment="Center" Click="CopyCommand_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </PivotItem>
                    </Pivot>
                </Expander>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
